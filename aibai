el.style.cssText = 'display:flex;flex-direction:column;height:100%;background:#0F1720;color:#DCE6EC;font-family:"IBM Plex Mono",monospace;font-size:12px;';

var OWN_ID = el.id.replace('canvas-', '');
var STORAGE_KEY = 'chat-' + OWN_ID;
var API_KEY = 'DIN_NYCKEL_HÄR';

var log = document.createElement('div');
log.style.cssText = 'flex:1;overflow-y:auto;padding:8px;';
el.appendChild(log);

var row = document.createElement('div');
row.style.cssText = 'display:flex;gap:6px;padding:8px;border-top:1px solid #2A3B47;';
var input = document.createElement('input');
input.placeholder = 'Skriv ett kommando...';
input.style.cssText = 'flex:1;background:#0F1720;color:#DCE6EC;border:1px solid #2A3B47;border-radius:6px;padding:8px;font-family:inherit;font-size:12px;';
var sendBtn = document.createElement('button');
sendBtn.textContent = 'Skicka';
sendBtn.style.cssText = 'background:#E8A33D;color:#0F1720;border:none;border-radius:6px;padding:8px 12px;font-weight:600;cursor:pointer;';
row.appendChild(input); row.appendChild(sendBtn);
el.appendChild(row);

function addMsg(role, text) {
  var m = document.createElement('div');
  m.style.cssText = 'margin-bottom:6px;white-space:pre-wrap;word-break:break-word;';
  m.style.color = role === 'user' ? '#8FBC94' : (role === 'system' ? '#7C93A3' : '#DCE6EC');
  m.textContent = (role === 'user' ? '> ' : '') + text;
  log.appendChild(m);
  log.scrollTop = log.scrollHeight;
}

var tools = [
  { name: 'list_boxes', description: 'Lista alla rutor med id och namn (den här AI-rutan har id "' + OWN_ID + '").', input_schema: { type: 'object', properties: {} } },
  { name: 'get_box_code', description: 'Hämta koden i en ruta (kan användas på sig själv med id "' + OWN_ID + '").', input_schema: { type: 'object', properties: { idOrName: { type: 'string' } }, required: ['idOrName'] } },
  { name: 'get_box_output', description: 'Hämta senaste utskrift/fel från en ruta, för att felsöka och rätta koden.', input_schema: { type: 'object', properties: { idOrName: { type: 'string' } }, required: ['idOrName'] } },
  { name: 'set_box_code', description: 'Skriv över koden i en befintlig ruta, inklusive denna AI-ruta själv (id "' + OWN_ID + '"). Ändring av denna ruta kräver att användaren trycker Kör igen för att aktiveras.', input_schema: { type: 'object', properties: { idOrName: { type: 'string' }, code: { type: 'string' } }, required: ['idOrName','code'] } },
  { name: 'add_box', description: 'Skapa en helt ny ruta med kod och valfritt namn.', input_schema: { type: 'object', properties: { code: { type: 'string' }, name: { type: 'string' } }, required: ['code'] } },
  { name: 'run_box', description: 'Kör koden i en ruta (inte denna AI-ruta).', input_schema: { type: 'object', properties: { idOrName: { type: 'string' } }, required: ['idOrName'] } },
  { name: 'delete_box', description: 'Ta bort en ruta.', input_schema: { type: 'object', properties: { idOrName: { type: 'string' } }, required: ['idOrName'] } },
  { name: 'rename_box', description: 'Byt namn på en ruta.', input_schema: { type: 'object', properties: { idOrName: { type: 'string' }, newName: { type: 'string' } }, required: ['idOrName','newName'] } }
];

function runTool(name, input) {
  try {
    switch (name) {
      case 'list_boxes': return { ok: true, boxes: window.KanvasAPI.listBoxes() };
      case 'get_box_code': return { ok: true, code: window.KanvasAPI.getBoxCode(input.idOrName) };
      case 'get_box_output': {
        var outEl = document.getElementById('output-' + resolveId(input.idOrName));
        return { ok: true, output: outEl ? outEl.innerText : null };
      }
      case 'set_box_code': {
        var isSelf = resolveId(input.idOrName) === OWN_ID;
        var r = window.KanvasAPI.setBoxCode(input.idOrName, input.code);
        return { ok: r, note: isSelf ? 'Detta var min egen kod. Tryck Kör på den här rutan igen för att ladda den nya versionen.' : undefined };
      }
      case 'add_box': return { ok: true, id: window.KanvasAPI.addBox(input.code, input.name) };
      case 'run_box': return { ok: window.KanvasAPI.runBoxById(input.idOrName) };
      case 'delete_box': return { ok: window.KanvasAPI.deleteBoxById(input.idOrName) };
      case 'rename_box': return { ok: window.KanvasAPI.renameBox(input.idOrName, input.newName) };
      default: return { ok: false, error: 'Okänt verktyg: ' + name };
    }
  } catch (e) { return { ok: false, error: e.message }; }
}

function resolveId(idOrName) {
  var list = window.KanvasAPI.listBoxes();
  var byId = list.filter(function (b) { return b.id === idOrName; })[0];
  if (byId) return byId.id;
  var lower = String(idOrName).toLowerCase();
  var byName = list.filter(function (b) { return b.name.toLowerCase() === lower; })[0];
  return byName ? byName.id : idOrName;
}

var messages = [];
var systemPrompt = "Du är en AI-assistent inbyggd i appen Kanvas (id på din egen ruta: '" + OWN_ID + "'). Du styr appen via verktygen: skapa, läsa, ändra, köra, döpa om och ta bort rutor (boxes), samt läsa deras senaste output/fel. Varje ruta innehåller JS-kod som körs som en async-funktion med parametern 'el' - koden kan console.log och/eller returnera ett värde. Du kan ändra din egen kod (id '" + OWN_ID + "') om användaren ber om det - berätta då att de måste trycka Kör igen. VIKTIGT - automatisk felrättning: när du skapar en ny ruta eller ändrar kod i en befintlig (som inte är dig själv), ska du ALLTID direkt efter: 1) köra rutan med run_box, 2) läsa resultatet med get_box_output, 3) om outputen visar ett fel, rätta koden med set_box_code och upprepa steg 1-2, i upp till 4 försök, helt utan att fråga användaren om lov mellan varje försök. Berätta bara för användaren när det är klart eller om du gett upp efter 4 försök. Svara kort.";

function saveHistory() {
  try { window.KanvasAPI.storageSet(STORAGE_KEY, JSON.stringify(messages.slice(-40))); } catch (e) {}
}

async function sendToClaude() {
  var res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': API_KEY,
      'anthropic-version': '2023-06-01',
      'anthropic-dangerous-direct-browser-access': 'true'
    },
    body: JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 1500, system: systemPrompt, messages: messages, tools: tools })
  });
  return res.json();
}

async function handleTurn() {
  var guard = 0;
  while (guard++ < 10) {
    var data = await sendToClaude();
    if (!data || !data.content) { addMsg('system', 'Fel: kunde inte tolka svaret.'); return; }
    var toolUses = [], textParts = [];
    data.content.forEach(function (b) {
      if (b.type === 'text') textParts.push(b.text);
      if (b.type === 'tool_use') toolUses.push(b);
    });
    if (textParts.length) addMsg('ai', textParts.join('\n'));
    messages.push({ role: 'assistant', content: data.content });
    saveHistory();
    if (toolUses.length === 0) return;
    var toolResults = toolUses.map(function (tu) {
      var result = runTool(tu.name, tu.input || {});
      addMsg('system', '\u2192 ' + tu.name + '(' + JSON.stringify(tu.input) + ') = ' + JSON.stringify(result));
      return { type: 'tool_result', tool_use_id: tu.id, content: JSON.stringify(result) };
    });
    messages.push({ role: 'user', content: toolResults });
    saveHistory();
  }
  addMsg('system', 'Avbröt efter för många steg.');
}

function send() {
  var text = input.value.trim();
  if (!text) return;
  input.value = '';
  addMsg('user', text);
  messages.push({ role: 'user', content: text });
  saveHistory();
  sendBtn.disabled = true;
  handleTurn().catch(function (e) { addMsg('system', 'Fel: ' + e.message); })
    .then(function () { sendBtn.disabled = false; });
}

sendBtn.addEventListener('click', send);
input.addEventListener('keydown', function (e) { if (e.key === 'Enter') send(); });

window.KanvasAPI.storageGet(STORAGE_KEY).then(function (r) {
  if (r && r.value) {
    try {
      messages = JSON.parse(r.value);
      messages.forEach(function (m) {
        if (m.role === 'user' && typeof m.content === 'string') addMsg('user', m.content);
        if (m.role === 'assistant') {
          var texts = (m.content || []).filter(function (b) { return b.type === 'text'; }).map(function (b) { return b.text; });
          if (texts.length) addMsg('ai', texts.join('\n'));
        }
      });
    } catch (e) {}
  }
  addMsg('system', 'AI-assistenten är redo. Prova t.ex. "gör en ny ruta som ritar en roterande kub".');
}).catch(function () {
  addMsg('system', 'AI-assistenten är redo.');
});
