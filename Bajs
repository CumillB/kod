</div>

<script>
(function () {
  "use strict";

  var CANVAS_SIZE = 4000;
  var BOX_HALF_WIDTH = 150;
  var fullscreenBoxId = null;
  var boxes = [];
  var nextNum = 1;
  var topZ = 10;
  var persistTimer = null;
  var statusTimer = null;
  var zoom = 1;
  var MIN_ZOOM = 0.15;
  var MAX_ZOOM = 2;

  var canvasEl = document.getElementById('canvas');
  var sizerEl = document.getElementById('canvas-sizer');
  var scrollEl = document.getElementById('canvas-scroll');

  // Works inside a Claude artifact (window.storage) and falls back to
  // localStorage automatically when this file is hosted standalone.
  var storageAdapter = {
    hasNative: function () {
      return typeof window.storage === 'object' && window.storage !== null
        && typeof window.storage.get === 'function';
    },
    get: function (key) {
      if (this.hasNative()) {
        return window.storage.get(key).catch(function () { return null; });
      }
      try {
        var raw = localStorage.getItem(key);
        return Promise.resolve(raw ? { key: key, value: raw } : null);
      } catch (e) {
        return Promise.resolve(null);
      }
    },
    set: function (key, value) {
      if (this.hasNative()) {
        return window.storage.set(key, value);
      }
      try {
        localStorage.setItem(key, value);
        return Promise.resolve({ key: key, value: value });
      } catch (e) {
        return Promise.reject(e);
      }
    },
    list: function (prefix) {
      if (this.hasNative() && typeof window.storage.list === 'function') {
        return window.storage.list(prefix).catch(function () { return { keys: [] }; });
      }
      try {
        var keys = [];
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && k.indexOf(prefix) === 0) keys.push(k);
        }
        return Promise.resolve({ keys: keys });
      } catch (e) {
        return Promise.resolve({ keys: [] });
      }
    },
    delete: function (key) {
      if (this.hasNative() && typeof window.storage.delete === 'function') {
        return window.storage.delete(key).catch(function () { return null; });
      }
      try {
        localStorage.removeItem(key);
        return Promise.resolve({ key: key, deleted: true });
      } catch (e) {
        return Promise.resolve(null);
      }
    }
  };

  function makeId() {
    return 'b' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  }

  // Zooms toward a specific point on screen (defaults to viewport center),
  // keeping the logical canvas point under that screen point fixed in place.
  function applyZoom(newZoom, centerX, centerY) {
    newZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, newZoom));
    if (centerX === undefined || centerY === undefined) {
      centerX = scrollEl.clientWidth / 2;
      centerY = scrollEl.clientHeight / 2;
    }
    var canvasX = (scrollEl.scrollLeft + centerX) / zoom;
    var canvasY = (scrollEl.scrollTop + centerY) / zoom;
    zoom = newZoom;
    canvasEl.style.transform = 'scale(' + zoom + ')';
    sizerEl.style.width = (CANVAS_SIZE * zoom) + 'px';
    sizerEl.style.height = (CANVAS_SIZE * zoom) + 'px';
    scrollEl.scrollLeft = canvasX * zoom - centerX;
    scrollEl.scrollTop = canvasY * zoom - centerY;
    var label = document.getElementById('zoomLabel');
    if (label) label.textContent = Math.round(zoom * 100) + '%';
  }

  // Two-finger pinch to zoom, tracked on the scrollable canvas viewport so it
  // works no matter where on the (possibly very large) canvas it starts.
  var activePointers = {};
  var pinchStartDist = null;
  var pinchStartZoom = null;
  var pinchStartMid = null;

  function pointDist(a, b) {
    return Math.sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y));
  }
  function pointMid(a, b) {
    return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
  }

  scrollEl.addEventListener('pointerdown', function (e) {
    if (e.target.closest('.box')) return; // let the box (textarea, 3D view, ...) own its own gestures
    activePointers[e.pointerId] = { x: e.clientX, y: e.clientY };
    var keys = Object.keys(activePointers);
    if (keys.length === 2) {
      var a = activePointers[keys[0]], b = activePointers[keys[1]];
      pinchStartDist = pointDist(a, b);
      pinchStartZoom = zoom;
      pinchStartMid = pointMid(a, b);
    }
  });

  scrollEl.addEventListener('pointermove', function (e) {
    if (!(e.pointerId in activePointers)) return;
    activePointers[e.pointerId] = { x: e.clientX, y: e.clientY };
    var keys = Object.keys(activePointers);
    if (keys.length === 2 && pinchStartDist) {
      e.preventDefault();
      var a = activePointers[keys[0]], b = activePointers[keys[1]];
      var ratio = pointDist(a, b) / pinchStartDist;
      var rect = scrollEl.getBoundingClientRect();
      applyZoom(pinchStartZoom * ratio, pinchStartMid.x - rect.left, pinchStartMid.y - rect.top);
    }
  }, { passive: false });

  function endPointerTrack(e) {
    delete activePointers[e.pointerId];
    if (Object.keys(activePointers).length < 2) pinchStartDist = null;
  }
  scrollEl.addEventListener('pointerup', endPointerTrack);
  scrollEl.addEventListener('pointercancel', endPointerTrack);
  scrollEl.addEventListener('pointerleave', endPointerTrack);

  function boxDisplayName(box) {
    return (box.name && box.name.trim()) ? box.name.trim() : ('Ruta ' + ('0' + box.num).slice(-2));
  }

  function setStatus(text) {
    var el = document.getElementById('status');
    if (el) el.textContent = text;
  }

  function stringifyArg(a) {
    if (a === undefined) return 'undefined';
    if (a === null) return 'null';
    if (typeof a === 'object') {
      try { return JSON.stringify(a); } catch (e) { return String(a); }
    }
    return String(a);
  }

  function serializeBox(b) {
    return { id: b.id, num: b.num, name: b.name || '', x: b.x, y: b.y, code: b.code, output: b.output || null };
  }

  var lastTouchedBoxId = null;
  function schedulePersist(boxId) {
    if (boxId) lastTouchedBoxId = boxId;
    clearTimeout(persistTimer);
    persistTimer = setTimeout(persist, 400);
  }

  function flashSaved(boxId) {
    if (!boxId) return;
    var el = document.getElementById('saved-' + boxId);
    if (!el) return;
    el.classList.add('show');
    clearTimeout(el._hideTimer);
    el._hideTimer = setTimeout(function () { el.classList.remove('show'); }, 1300);
  }

  function persist() {
    setStatus('Sparar…');
    var touched = lastTouchedBoxId;
    var payload = JSON.stringify({ boxes: boxes.map(serializeBox), nextNum: nextNum });
    storageAdapter.set('kanvas-boxes', payload).then(function () {
      setStatus('Sparat');
      clearTimeout(statusTimer);
      statusTimer = setTimeout(function () { setStatus(''); }, 1400);
      flashSaved(touched);
    }).catch(function () {
      setStatus('Kunde inte spara');
    });
  }

  function loadState() {
    return storageAdapter.get('kanvas-boxes').then(function (result) {
      if (result && result.value) {
        var parsed = JSON.parse(result.value);
        boxes = parsed.boxes || [];
        nextNum = parsed.nextNum || (boxes.length + 1);
      }
    }).catch(function () {
      boxes = [];
      nextNum = 1;
    });
  }

  function renderOutput(outputEl, output) {
    outputEl.innerHTML = '';
    if (output.error) {
      var e = document.createElement('div');
      e.className = 'out-error';
      e.textContent = '✕ ' + output.error;
      outputEl.appendChild(e);
      return;
    }
    (output.logs || []).forEach(function (line) {
      var l = document.createElement('div');
      l.className = 'out-log';
      l.textContent = line;
      outputEl.appendChild(l);
    });
