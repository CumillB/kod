      var x = (scrollEl.scrollLeft + scrollEl.clientWidth / 2) / zoom - BOX_HALF_WIDTH + offset;
      var y = (scrollEl.scrollTop + 70) / zoom + offset;
      var box = { id: makeId(), num: nextNum++, name: name || '', x: x, y: y, code: code || '', output: null };
