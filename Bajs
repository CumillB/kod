  // Loads a classic (non-module) script once, for boxes that want a UMD-style
  // CDN library instead of an ES module. Available to box code as loadScript(url).
  window.loadScript = function (src) {
    if (document.querySelector('script[data-kanvas-src="' + src + '"]')) {
      return Promise.resolve();
    }
    return new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = src;
      s.setAttribute('data-kanvas-src', src);
      s.onload = function () { resolve(); };
      s.onerror = function () { reject(new Error('Kunde inte ladda ' + src)); };
      document.head.appendChild(s);
    });
