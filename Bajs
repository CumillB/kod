  // ---- Move to another device (export/import everything Kanvas has stored) ----
  function utf8ToBase64(str) {
    var bytes = new TextEncoder().encode(str);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
    return btoa(binary);
  }
  function base64ToUtf8(b64) {
    var binary = atob(b64);
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  async function exportState() {
    var listResult = await storageAdapter.list('kanvas-');
    var keys = (listResult && listResult.keys) || [];
    var data = {};
    for (var i = 0; i < keys.length; i++) {
      var r = await storageAdapter.get(keys[i]);
      if (r && r.value !== undefined && r.value !== null) data[keys[i]] = r.value;
    }
    return utf8ToBase64(JSON.stringify({ v: 1, data: data }));
  }

  async function importState(code) {
