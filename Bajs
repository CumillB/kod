  // fixed on a descendant of a transformed ancestor is scoped to that
  // ancestor, not the real viewport - so to get a true fullscreen box we
  // temporarily move it out to the document body, then put it back exactly
  // where it was (box.x/box.y are never touched, so nothing is lost).
  function exitBoxFullscreen() {
    if (!fullscreenBoxId) return;
    var box = findBox(fullscreenBoxId);
    var boxEl = document.getElementById('box-' + fullscreenBoxId);
    if (boxEl) {
      boxEl.classList.remove('fullscreen');
      if (box) {
        if (box._returnNext && box._returnNext.parentNode === canvasEl) {
          canvasEl.insertBefore(boxEl, box._returnNext);
        } else {
          canvasEl.appendChild(boxEl);
        }
        boxEl.style.left = box.x + 'px';
        boxEl.style.top = box.y + 'px';
      }
