  // Stops any animation loop and disposers registered by a previous run of
  // this box, then empties its visual area. Called before every re-run and
  // on delete, so boxes doing WebGL/canvas animation don't pile up.
  function cleanupCanvas(canvasEl) {
    if (canvasEl._rafId) {
      cancelAnimationFrame(canvasEl._rafId);
      canvasEl._rafId = null;
    }
    if (canvasEl._disposers) {
      canvasEl._disposers.forEach(function (fn) {
        try { fn(); } catch (e) { /* ignore cleanup errors */ }
      });
    }
    canvasEl._disposers = [];
    canvasEl.innerHTML = '';
  }

