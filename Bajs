      var r = document.createElement('div');
      r.className = 'out-result';
      r.textContent = '→ ' + stringifyArg(output.result);
      outputEl.appendChild(r);
    }
    if (!(output.logs && output.logs.length) && !output.hasResult) {
      var n = document.createElement('div');
      n.className = 'out-empty';
