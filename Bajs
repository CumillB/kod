  function addBox() {
    var offset = (boxes.length % 6) * 24;
    var x = (scrollEl.scrollLeft + scrollEl.clientWidth / 2) / zoom - BOX_HALF_WIDTH + offset;
    var y = (scrollEl.scrollTop + 70) / zoom + offset;
    var box = {
      id: makeId(), num: nextNum++, name: '', x: x, y: y,
      code: '// din kod h\u00E4r\nconsole.log("hej!");',
      output: null
    };
    boxes.push(box);
    canvasEl.appendChild(createBoxElement(box));
    schedulePersist(box.id);
  }

  function init() {
    setStatus('Laddar…');
    loadState().then(function () {
      if (boxes.length === 0) {
        boxes.push({
          id: makeId(), num: 1, name: 'Exempel',
          x: CANVAS_SIZE / 2 - BOX_HALF_WIDTH, y: CANVAS_SIZE / 2 - BOX_HALF_WIDTH,
          code: 'console.log("Hej fr\u00E5n ruta 1!");\nreturn 6 * 7;',
          output: null
        });
        nextNum = 2;
      }
      boxes.forEach(function (box) {
        canvasEl.appendChild(createBoxElement(box));
      });
      requestAnimationFrame(function () {
        scrollEl.scrollLeft = CANVAS_SIZE / 2 - scrollEl.clientWidth / 2;
        scrollEl.scrollTop = CANVAS_SIZE / 2 - scrollEl.clientHeight / 2;
      });
      setStatus('');
    });
