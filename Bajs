  // requestAnimationFrame loop (see the el._rafId convention above) - a box
  // that just logs something and returns is never "running" in this sense,
  // since there's nothing left going for Stoppa to stop.
  function isRunning(canvasEl) {
    return !!canvasEl._rafId;
  }

  function setRunButtonState(runBtn, running) {
