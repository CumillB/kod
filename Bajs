    runBtn.classList.toggle('running', running);
  }

  function finalizeRun(box, outputEl, canvasEl, boxEl, output) {
    box.output = output;
    renderOutput(outputEl, output);
    if (canvasEl.children.length === 0) {
      canvasEl.classList.remove('has-content');
    }
    boxEl.classList.remove('pulse');
    void boxEl.offsetWidth;
    boxEl.classList.add('pulse');
    schedulePersist(box.id);
    var runBtnEl = boxEl.querySelector('.run-btn');
    if (runBtnEl) setRunButtonState(runBtnEl, isRunning(canvasEl));
  }

  // Runs a box's code as an async function. The code receives `el`, a div it
  // can render into (append a <canvas>, a Three.js renderer, etc.) — anything
  // left running (requestAnimationFrame, WebGL) should be registered via
  // el._rafId and el._disposers.push(fn) so Kanvas can clean it up later.
  // console.log calls are captured for the whole async run, including
  // anything logged after an `await`.
  // Code pasted in from a chat or notes app often arrives with typographic
  // quotes/spaces instead of plain ASCII ones, which breaks the JS parser
  // with exactly "Invalid or unexpected token". Normalize before running.
  function sanitizeCode(code) {
    return code
      .replace(/[\u2018\u2019\u201A\u201B]/g, "'")
      .replace(/[\u201C\u201D\u201E\u201F]/g, '"')
      .replace(/\u00A0/g, ' ');
  }

  function runBox(box, outputEl, canvasEl, boxEl) {
    cleanupCanvas(canvasEl);
    canvasEl.classList.add('has-content');
    var logs = [];
    var originalLog = console.log;
    console.log = function () {
      var args = Array.prototype.slice.call(arguments);
      logs.push(args.map(stringifyArg).join(' '));
    };
    var wrapped;
    try {
      wrapped = new Function('el', 'return (async function () {\n' + sanitizeCode(box.code) + '\n})()');
    } catch (err) {
      console.log = originalLog;
      finalizeRun(box, outputEl, canvasEl, boxEl, { logs: logs, hasResult: false, result: null, error: err.message });
      return;
    }
    Promise.resolve().then(function () {
      return wrapped(canvasEl);
    }).then(function (result) {
      console.log = originalLog;
      finalizeRun(box, outputEl, canvasEl, boxEl, {
        logs: logs, hasResult: result !== undefined,
        result: result === undefined ? null : result, error: null
      });
    }).catch(function (err) {
      console.log = originalLog;
      finalizeRun(box, outputEl, canvasEl, boxEl, {
        logs: logs, hasResult: false, result: null,
        error: (err && err.message) || String(err)
      });
    });
  }

  function makeDraggable(header, box, el) {
