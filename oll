// Kanvas AI-ruta: chatt mot Ollama. Vanilla JS, inga imports. Körs med new Function('el', code)(container)
const PRESETS = [
  { name: 'Kodhjälp (vanilla JS)', text: "Du är en expert på JavaScript. Skriv alltid ren vanilla JavaScript utan imports, exports, ramverk eller build-steg, så att koden kan köras direkt via new Function('el', code)(container) där el är en container-div. Svara kort på svenska och visa koden i kodblock." },
  { name: 'Svensk chatt', text: 'Du är en hjälpsam assistent. Svara på svenska, kort och tydligt.' },
  { name: 'Översättare', text: 'Du är en översättare. Översätt text mellan svenska och engelska. Svara bara med översättningen.' },
  { name: 'Genealogi', text: 'Du hjälper till att tyda och transkribera gamla svenska och danska kyrkböcker och släktdata. Förklara gamla ord och förkortningar och var tydlig med vad som är osäkert.' }
];
const LS = 'kanvas_ai_ruta_v1';
const DEF = { url: 'http://localhost:11434', model: 'qwen2.5:7b', system: PRESETS[0].text, temp: 0.7, ctx: 4096, keep: '10m', font: 14 };

let cfg = Object.assign({}, DEF), history = [], busy = false, ctrl = null;
try {
  const s = JSON.parse(localStorage.getItem(LS) || '{}');
  if (s.cfg) cfg = Object.assign(cfg, s.cfg);
  if (Array.isArray(s.history)) history = s.history;
} catch (e) {}
function save() {
  try { localStorage.setItem(LS, JSON.stringify({ cfg, history: history.slice(-60) })); } catch (e) {}
}

