function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function inline(t) {
  return esc(t).replace(/`([^`\n]+)`/g, '<code>$1</code>').replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
}
function render(text) {
  return text.split('```').map((part, i) => {
    if (i % 2 === 0) return inline(part);
    const nl = part.indexOf('\n');
    const lang = nl > -1 ? part.slice(0, nl).trim() : part.trim();
    const code = nl > -1 ? part.slice(nl + 1) : '';
    return '<div class="kai-code"><div class="kai-ch"><span>' + esc(lang || 'kod') + '</span><button data-copy="1">Kopiera</button></div><pre>' + esc(code) + '</pre></div>';
  }).join('');
}
function copyText(t, btn) {
  const done = () => { if (btn) { const o = btn.textContent; btn.textContent = 'Kopierad!'; setTimeout(() => btn.textContent = o, 1200); } };
  const fb = () => { const ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } catch (e) {} ta.remove(); };
  if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done, fb); else fb();
}

const msgs = $('msgs');
function applyFont() { msgs.style.fontSize = cfg.font + 'px'; $('inp').style.fontSize = cfg.font + 'px'; }
function scroll() { msgs.scrollTop = msgs.scrollHeight; }
function addBubble(m) {
  const d = document.createElement('div');
  d.className = 'kai-m ' + m.role;
  d.innerHTML = m.role === 'user' ? inline(m.content) : render(m.content);
  if (m.stats) { const s = document.createElement('div'); s.className = 'kai-st'; s.textContent = m.stats; d.appendChild(s); }
  msgs.appendChild(d);
  return d;
}
function drawAll() {
  msgs.innerHTML = '';
  if (!history.length) {
    msgs.innerHTML = '<div class="kai-empty"><b>Hej! 👋</b>Fråga vad du vill. Körs lokalt på din dator.</div>';
    return;
  }
  history.forEach(addBubble);
  scroll();
}
msgs.addEventListener('click', e => {
  const b = e.target.closest('[data-copy]');
  if (!b) return;
  const pre = b.closest('.kai-code').querySelector('pre');
  copyText(pre.textContent, b);
});

function base() { return cfg.url.replace(/\/+$/, ''); }
async function loadModels(showErr) {
  try {
    const r = await fetch(base() + '/api/tags');
    const j = await r.json();
    const names = (j.models || []).map(m => m.name);
    $('dot').classList.add('ok');
    const sel = $('sModel');
    sel.innerHTML = '';
    if (!names.includes(cfg.model)) names.unshift(cfg.model);
    names.forEach(n => { const o = document.createElement('option'); o.value = n; o.textContent = n; sel.appendChild(o); });
    sel.value = cfg.model;
    return names.length;
  } catch (e) {
    $('dot').classList.remove('ok');
    const sel = $('sModel');
    if (!sel.options.length) { const o = document.createElement('option'); o.value = cfg.model; o.textContent = cfg.model; sel.appendChild(o); }
    if (showErr) throw e;
    return 0;
  }
}

async function send() {
  if (busy) { if (ctrl) ctrl.abort(); return; }
  const inp = $('inp');
  const text = inp.value.trim();
  if (!text) return;
  inp.value = ''; inp.style.height = 'auto';
  if (!history.length) msgs.innerHTML = '';
  const um = { role: 'user', content: text };
  history.push(um); addBubble(um);
  const am = { role: 'assistant', content: '' };
  const bub = addBubble({ role: 'assistant', content: '' });
  bub.innerHTML = '<span style="color:var(--m)">Tänker...</span>';
  scroll();
  busy = true; ctrl = new AbortController();
  $('bSend').textContent = 'Stopp'; $('bSend').classList.add('stop');
  let pending = false;
  const paint = () => { if (pending) return; pending = true; requestAnimationFrame(() => { pending = false; bub.innerHTML = render(am.content); scroll(); }); };
  try {
    const body = {
      model: cfg.model, stream: true, keep_alive: cfg.keep === '-1' ? -1 : cfg.keep,
      options: { temperature: Number(cfg.temp), num_ctx: Number(cfg.ctx) },
      messages: [{ role: 'system', content: cfg.system }].concat(history.map(m => ({ role: m.role, content: m.content })))
    };
    const r = await fetch(base() + '/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), signal: ctrl.signal });
    if (!r.ok) throw new Error('Servern svarade ' + r.status + ': ' + (await r.text()).slice(0, 200));
    $('dot').classList.add('ok');
    const rd = r.body.getReader(), dec = new TextDecoder();
    let buf = '';
    for (;;) {
      const { value, done } = await rd.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      let i;
      while ((i = buf.indexOf('\n')) > -1) {
        const line = buf.slice(0, i).trim(); buf = buf.slice(i + 1);
        if (!line) continue;
        let j; try { j = JSON.parse(line); } catch (e) { continue; }
        if (j.error) throw new Error(j.error);
        if (j.message && j.message.content) { am.content += j.message.content; paint(); }
        if (j.done && j.eval_count && j.eval_duration) {
          am.stats = j.eval_count + ' tokens · ' + (j.eval_count / (j.eval_duration / 1e9)).toFixed(1) + ' tok/s';
        }
      }
    }
  } catch (e) {
    if (e.name === 'AbortError') { am.content += (am.content ? '\n\n' : '') + '_(stoppad)_'; }
    else {
      $('dot').classList.remove('ok');
      am.content = 'Kunde inte nå AI:n.\n' + e.message + '\n\nKolla att Ollama körs, att adressen i ⚙ stämmer och (från telefon/APK) att OLLAMA_ORIGINS=* är satt på datorn.';
      am.err = true;
    }
  }
  bub.innerHTML = render(am.content);
  if (am.err) bub.classList.add('err');
  if (am.stats) { const s = document.createElement('div'); s.className = 'kai-st'; s.textContent = am.stats; bub.appendChild(s); }
  if (!am.err) history.push(am);
  save(); scroll();
  busy = false; ctrl = null;
  $('bSend').textContent = 'Skicka'; $('bSend').classList.remove('stop');
}

// Inställningar
function fillSettings() {
  $('sUrl').value = cfg.url; $('sSys').value = cfg.system;
  $('sTemp').value = cfg.temp; $('vTemp').textContent = cfg.temp;
  $('sCtx').value = String(cfg.ctx); $('sKeep').value = cfg.keep;
  $('sFont').value = cfg.font; $('vFont').textContent = cfg.font;
  $('mname').textContent = cfg.model;
}
const pre = $('sPre');
pre.innerHTML = '<option value="">Välj förinställning...</option>' + PRESETS.map((p, i) => '<option value="' + i + '">' + esc(p.name) + '</option>').join('');
pre.onchange = () => { if (pre.value !== '') { cfg.system = PRESETS[pre.value].text; $('sSys').value = cfg.system; save(); } };
$('sUrl').onchange = () => { cfg.url = $('sUrl').value.trim() || DEF.url; save(); loadModels(); };
$('sModel').onchange = () => { cfg.model = $('sModel').value; $('mname').textContent = cfg.model; save(); };
$('sSys').oninput = () => { cfg.system = $('sSys').value; save(); };
$('sTemp').oninput = () => { cfg.temp = Number($('sTemp').value); $('vTemp').textContent = cfg.temp; save(); };
$('sCtx').onchange = () => { cfg.ctx = Number($('sCtx').value); save(); };
$('sKeep').onchange = () => { cfg.keep = $('sKeep').value; save(); };
$('sFont').oninput = () => { cfg.font = Number($('sFont').value); $('vFont').textContent = cfg.font; applyFont(); save(); };
$('bRef').onclick = () => { $('tres').textContent = 'Hämtar...'; loadModels(true).then(n => $('tres').textContent = n + ' modeller hittades.').catch(e => $('tres').textContent = 'Fel: ' + e.message); };
$('bTest').onclick = $('bRef').onclick;
$('bExp').onclick = e => copyText(history.map(m => (m.role === 'user' ? 'Du: ' : 'AI: ') + m.content).join('\n\n'), e.target);
$('bClr').onclick = () => { history = []; save(); drawAll(); $('set').classList.remove('open'); };
$('bNew').onclick = $('bClr').onclick;
$('bSet').onclick = () => { fillSettings(); $('set').classList.add('open'); };
$('bClose').onclick = $('bDone').onclick = () => $('set').classList.remove('open');

$('bSend').onclick = send;
$('inp').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } });
$('inp').addEventListener('input', e => { const t = e.target; t.style.height = 'auto'; t.style.height = Math.min(t.scrollHeight, 140) + 'px'; });

fillSettings(); applyFont(); drawAll(); loadModels();
