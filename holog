  }
  if (/\b(hide|close)\b.*\bchat\b|\bvoice (only|mode)\b/i.test(text)) {
    setChat(true); setHands(true, true); addLine('jarvis', 'Voice mode on. Say "show chat" to bring it back.'); speak('Voice mode on. Say show chat to bring it back.'); return;
  }
  if (/\b(show|open)\b.*\bchat\b|\btext mode\b/i.test(text)) {
    setChat(false); setHands(false, true); addLine('jarvis', 'Chat restored.'); speak('Chat restored.'); return;
  }
  const key = getKey();
  if (!key) { addLine('jarvis', 'I need an API key. Press 🔑 (show chat first).'); setMode('idle'); setHands(false, true); return; }
  history.push({ role: 'user', content: text });
  setMode('thinking');
  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-api-key': key,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 6000, system: sys(), tools: [HOLO_TOOL], messages: history.slice(-20) })
    });
    const d = await r.json();
    if (!r.ok) throw new Error((d.error && d.error.message) || r.status);
    const blocks = d.content || [];
    const tu = blocks.filter(b => b.type === 'tool_use' && b.name === 'build_hologram');
    tu.forEach(b => buildHolo(b.input));
    let out = blocks.filter(b => b.type === 'text').map(b => b.text).join('\n').trim();
    if (!out) out = tu.length ? 'Hologram of ' + (tu[0].input.name || 'object') + ' rendered.' : '…';
    history.push({ role: 'assistant', content: out });
    addLine('jarvis', out);
    speak(out);
  } catch (e) {
    history.pop();
    addLine('jarvis', 'Error: ' + e.message);
    setMode('idle');
    if (hands) setTimeout(listen, 1500);
  }
}

// ---------- Buttons ----------
const send = () => { const v = inEl.value; inEl.value = ''; ask(v); };
$('jv-send').onclick = send;
inEl.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });
$('jv-key').onclick = () => {
  const k = prompt('Paste your Anthropic API key (only stored in your browser):', '');
  if (k !== null) { try { localStorage.setItem('jarvis_key', k.trim()); addLine('jarvis', k.trim() ? 'Key saved.' : 'Key removed.'); } catch (e) {} }
};

// ---------- Voice-only mode ----------
const bar = $('jv-key').parentNode, col = bar.parentNode;
const sub = document.createElement('div');
sub.style.cssText = 'display:none;text-align:center;font-size:15px;line-height:1.4;padding:8px 12px;color:#d8f8ff;text-shadow:0 0 8px #00e5ff;max-height:22vh;overflow:hidden;pointer-events:none;';
col.insertBefore(sub, logEl);
const mkBtn = (label, title) => {
  const b = document.createElement('button');
  b.textContent = label; b.title = title;
  b.style.cssText = 'width:44px;border-radius:10px;border:1px solid rgba(0,229,255,.4);background:transparent;color:#00e5ff;font-size:16px;';
  bar.appendChild(b); return b;
};
const bHands = mkBtn('🎧', 'Hands-free'), bHide = mkBtn('🙈', 'Hide chat');
let hidden = false, subT = 0;
const baseAdd = addLine;
addLine = (who, text) => {
  baseAdd(who, text);
  if (!hidden) return;
  sub.textContent = (who === 'you' ? '› ' : '') + text;
  sub.style.opacity = who === 'you' ? '.6' : '1';
  clearTimeout(subT); subT = setTimeout(() => { sub.textContent = ''; }, 12000);
};
function setChat(h) {
  hidden = h;
  logEl.style.display = h ? 'none' : '';
  [inEl, $('jv-send'), $('jv-key')].forEach(x => x.style.display = h ? 'none' : '');
  sub.style.display = h ? 'block' : 'none';
  bar.style.justifyContent = h ? 'center' : '';
  bHide.textContent = h ? '💬' : '🙈';
  bHide.title = h ? 'Show chat' : 'Hide chat';
}
function setHands(v, quiet) {
  hands = v;
  bHands.style.background = v ? 'rgba(102,255,153,.25)' : 'transparent';
  bHands.style.borderColor = v ? '#66ff99' : 'rgba(0,229,255,.4)';
  if (v) { if (!quiet) listen(); }
  else { try { rec && rec.abort(); } catch (e) {} }
}
bHide.onclick = () => { setChat(!hidden); if (!hidden) setHands(false); else setHands(true); };
bHands.onclick = () => setHands(!hands);
$('jv-mic').onclick = () => { if (rec && hands) setHands(false); else listen(); };

addLine('jarvis', 'Systems online. How may I assist you?');

// ---------- Cleanup ----------
off(() => {
  scene.traverse(o => {
    if (o.geometry) o.geometry.dispose();
    if (o.material) { if (o.material.map) o.material.map.dispose(); o.material.dispose(); }
  });
  [brightMat, blurMat, compMat].forEach(m => m.dispose());
  quad.geometry.dispose(); quad.material.dispose();
  disposeTargets();
  gtex.dispose();
  renderer.dispose();
  cv.remove(); ui.remove();
});
