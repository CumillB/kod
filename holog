// ===== J.A.R.V.I.S – runs in the canvas (container: el) =====
// 3D reactor + voice (en-US) + chat with Claude + animated holograms + voice-only mode.
// Enter your API key in the app (🔑); it is only stored in your browser.

const THREE = window.THREE || await import('three');
el._disposers = el._disposers || [];
const off = fn => el._disposers.push(fn);

// ---------- UI ----------
el.innerHTML = '';
el.style.position = 'relative';
el.style.overflow = 'hidden';
el.style.background = 'radial-gradient(circle at 50% 35%, #06202b 0%, #02060c 70%)';
el.style.fontFamily = 'ui-monospace, Menlo, Consolas, monospace';
el.style.color = '#9eeaff';
el.style.minHeight = el.style.minHeight || '480px';

const ui = document.createElement('div');
ui.style.cssText = 'position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none;z-index:2;';
ui.innerHTML = `
  <div style="padding:14px 20px;display:flex;justify-content:space-between;align-items:center;">
    <div style="letter-spacing:.35em;font-size:15px;color:#00e5ff;text-shadow:0 0 8px #00e5ff;">J.A.R.V.I.S</div>
    <div id="jv-status" style="font-size:12px;opacity:.8;letter-spacing:.2em;">IDLE</div>
  </div>
  <div style="display:flex;flex-direction:column;gap:8px;padding:14px;width:100%;max-width:820px;margin:0 auto;box-sizing:border-box;">
    <div id="jv-log" style="pointer-events:auto;max-height:30vh;overflow-y:auto;font-size:13px;line-height:1.45;
         background:rgba(0,20,30,.55);border:1px solid rgba(0,229,255,.25);border-radius:10px;padding:8px 10px;"></div>
    <div style="display:flex;gap:6px;pointer-events:auto;">
      <button id="jv-mic" title="Speak" style="width:44px;border-radius:10px;border:1px solid #00e5ff;background:rgba(0,229,255,.12);color:#00e5ff;font-size:18px;">🎤</button>
      <input id="jv-in" placeholder="Type to Jarvis…" autocomplete="off"
         style="flex:1;min-width:0;padding:10px;border-radius:10px;border:1px solid rgba(0,229,255,.4);background:rgba(0,10,16,.8);color:#d8f8ff;font:inherit;font-size:16px;outline:none;">
      <button id="jv-send" style="padding:0 14px;border-radius:10px;border:1px solid #00e5ff;background:rgba(0,229,255,.12);color:#00e5ff;">Send</button>
      <button id="jv-key" title="API key" style="width:44px;border-radius:10px;border:1px solid rgba(0,229,255,.4);background:transparent;color:#00e5ff;font-size:16px;">🔑</button>
    </div>
  </div>`;
el.appendChild(ui);
const $ = id => ui.querySelector('#' + id);
const logEl = $('jv-log'), statusEl = $('jv-status'), inEl = $('jv-in');

function addLine(who, text) {
  const d = document.createElement('div');
  d.style.margin = '3px 0';
  const b = document.createElement('b');
  b.textContent = who === 'you' ? 'You: ' : 'Jarvis: ';
  b.style.color = who === 'you' ? '#ffd180' : '#00e5ff';
  d.appendChild(b);
  d.appendChild(document.createTextNode(text));
  logEl.appendChild(d);
  logEl.scrollTop = logEl.scrollHeight;
}

// ---------- State ----------
let mode = 'idle'; // idle | listening | thinking | speaking
const LABEL = { idle: 'IDLE', listening: 'LISTENING', thinking: 'THINKING', speaking: 'SPEAKING' };
const COLOR = { idle: 0x00bcd4, listening: 0x66ff99, thinking: 0xffb300, speaking: 0x00e5ff };
const SPEED = { idle: 1, listening: 2, thinking: 4, speaking: 2.5 };
function setMode(m) { if (m !== mode) pulseWave(); mode = m; statusEl.textContent = LABEL[m]; }

// ---------- 3D reactor ----------
const W = () => el.clientWidth || 960;
const H = () => el.clientHeight || 600;
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(50, W() / H(), 0.1, 200);
camera.position.z = 20;
const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
renderer.setSize(W(), H(), false);
renderer.setClearColor(0x000000, 0);
renderer.sortObjects = false; // additive blending is order-independent
const cv = renderer.domElement;
cv.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;touch-action:none;z-index:1;';
el.appendChild(cv);

// Point size in pixels, shared by all GPU particles and follows the resolution
const pxU = { value: 1 };
const syncPx = () => { pxU.value = renderer.getPixelRatio() * H() / 2; };
syncPx();

// All colors that follow the mode are collected here and lerped smoothly
const tint = new THREE.Color(COLOR.idle);
const goal = new THREE.Color(COLOR.idle);
const tints = [];
const ADD = { blending: THREE.AdditiveBlending, depthWrite: false, transparent: true };
const mk = (op = 1, extra = {}) => { const m = new THREE.MeshBasicMaterial({ color: COLOR.idle, opacity: op, ...ADD, ...extra }); tints.push(m.color); return m; };
// Soft objects go in layer 1 (rendered without MSAA), sharp ones in layer 0
const soft = o => { o.layers.set(1); return o; };

// Soft glow texture (drawn on a canvas, no external files)
function glowTex() {
  const c = document.createElement('canvas'); c.width = c.height = 128;
  const g = c.getContext('2d');
  const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
  gr.addColorStop(0, 'rgba(255,255,255,1)');
  gr.addColorStop(0.25, 'rgba(255,255,255,0.45)');
  gr.addColorStop(1, 'rgba(255,255,255,0)');
  g.fillStyle = gr; g.fillRect(0, 0, 128, 128);
  return new THREE.CanvasTexture(c);
}
const gtex = glowTex();

// Random direction on the unit sphere
const rd = () => {
  const th = Math.random() * Math.PI * 2, ph = Math.acos(2 * Math.random() - 1);
  return [Math.sin(ph) * Math.cos(th), Math.sin(ph) * Math.sin(th), Math.cos(ph)];
};

// ----- Bloom: sharp layer (MSAA) + soft layer (no MSAA) -> threshold -> 3 blur levels -> composite -----
let bloomOK = false, rtScene = null, rtSoft = null, rtA = [], rtB = [];
const LV = 3;
const quadScene = new THREE.Scene();
const quadCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), new THREE.MeshBasicMaterial());
quad.frustumCulled = false;
quadScene.add(quad);
const QV = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }`;
const QM = { depthTest: false, depthWrite: false };

const brightMat = new THREE.ShaderMaterial({
  ...QM, uniforms: { tMap: { value: null }, tSoft: { value: null } }, vertexShader: QV,
  fragmentShader: `uniform sampler2D tMap; uniform sampler2D tSoft; varying vec2 vUv;
    void main(){ vec3 c = min(max(texture2D(tMap, vUv).rgb + texture2D(tSoft, vUv).rgb, vec3(0.0)), vec3(32.0)); float l = max(c.r, max(c.g, c.b));
      gl_FragColor = vec4(c * smoothstep(0.1, 0.6, l) * 1.6, 1.0); }`
});
const blurMat = new THREE.ShaderMaterial({
  ...QM, uniforms: { tMap: { value: null }, uDir: { value: new THREE.Vector2() } }, vertexShader: QV,
  fragmentShader: `uniform sampler2D tMap; uniform vec2 uDir; varying vec2 vUv;
    void main(){
      vec3 s = texture2D(tMap, vUv).rgb * 0.2270270270;
      s += texture2D(tMap, vUv + uDir * 1.3846153846).rgb * 0.3162162162;
      s += texture2D(tMap, vUv - uDir * 1.3846153846).rgb * 0.3162162162;
      s += texture2D(tMap, vUv + uDir * 3.2307692308).rgb * 0.0702702703;
      s += texture2D(tMap, vUv - uDir * 3.2307692308).rgb * 0.0702702703;
      gl_FragColor = vec4(s, 1.0); }`
});
const compMat = new THREE.ShaderMaterial({
  ...QM, uniforms: { tScene: { value: null }, tSoft: { value: null }, tB0: { value: null }, tB1: { value: null }, tB2: { value: null }, uBloom: { value: 1 } },
  vertexShader: QV,
  fragmentShader: `uniform sampler2D tScene; uniform sampler2D tSoft; uniform sampler2D tB0; uniform sampler2D tB1; uniform sampler2D tB2; uniform float uBloom; varying vec2 vUv;
    vec3 smp(vec2 uv){ return min(max(texture2D(tScene, uv).rgb + texture2D(tSoft, uv).rgb, vec3(0.0)), vec3(32.0)); }
    void main(){
      vec2 d = vUv - 0.5; float r2 = dot(d, d);
      vec2 o = d * 0.004 * (0.4 + r2 * 3.0);
      vec3 s = vec3(smp(vUv + o).r, smp(vUv).g, smp(vUv - o).b);
      vec3 b = texture2D(tB0, vUv).rgb * 0.5 + texture2D(tB1, vUv).rgb * 0.8 + texture2D(tB2, vUv).rgb * 1.0;
      vec3 c = s + b * uBloom;
      c = vec3(1.0) - exp(-c * 1.2);
      c = pow(c, vec3(1.0 / 2.2));
      gl_FragColor = vec4(c, clamp(max(c.r, max(c.g, c.b)), 0.0, 1.0)); }`
});

function disposeTargets() {
  [rtScene, rtSoft, ...rtA, ...rtB].forEach(r => r && r.dispose());
  rtScene = null; rtSoft = null; rtA = []; rtB = [];
}
function rtOK(rt) {
  try {
    renderer.setRenderTarget(rt);
    renderer.clear();
    const gl = renderer.getContext();
    const ok = gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE;
    renderer.setRenderTarget(null);
    return ok;
  } catch (e) { renderer.setRenderTarget(null); return false; }
}
function buildTargets(type, samples) {
  disposeTargets();
  // No depth buffer: everything is additive without depth writes
  const o = { type, minFilter: THREE.LinearFilter, magFilter: THREE.LinearFilter, depthBuffer: false };
  rtScene = new THREE.WebGLRenderTarget(2, 2, { ...o, samples });
  rtSoft = new THREE.WebGLRenderTarget(2, 2, o);
  for (let i = 0; i < LV; i++) { rtA.push(new THREE.WebGLRenderTarget(2, 2, o)); rtB.push(new THREE.WebGLRenderTarget(2, 2, o)); }
  sizeTargets();
  return rtOK(rtScene) && rtOK(rtSoft) && rtOK(rtB[0]) && rtOK(rtB[LV - 1]);
}
function sizeTargets() {
  if (!rtScene) return;
  const s = renderer.getDrawingBufferSize(new THREE.Vector2());
  rtScene.setSize(s.x, s.y);
  rtSoft.setSize(s.x, s.y);
  for (let i = 0; i < LV; i++) {
    const w = Math.max(2, s.x >> (i + 1)), h = Math.max(2, s.y >> (i + 1));
    rtA[i].setSize(w, h); rtB[i].setSize(w, h);
  }
}
(function initBloom() {
  const ext = renderer.extensions;
  const half = ext.has('EXT_color_buffer_float') || ext.has('EXT_color_buffer_half_float');
  const gl2 = renderer.capabilities.isWebGL2 !== false;
  const tries = [];
  if (half && gl2) tries.push([THREE.HalfFloatType, 4]);
  if (half) tries.push([THREE.HalfFloatType, 0]);
  tries.push([THREE.UnsignedByteType, gl2 ? 4 : 0], [THREE.UnsignedByteType, 0]);
  for (const [ty, sm] of tries) {
    try { if (buildTargets(ty, sm)) { bloomOK = true; return; } } catch (e) {}
  }
  disposeTargets();
})();

function pass(mat, target) { quad.material = mat; renderer.setRenderTarget(target); renderer.render(quadScene, quadCam); }
function blur(src, tmp, dst) {
  blurMat.uniforms.tMap.value = src.texture; blurMat.uniforms.uDir.value.set(1 / tmp.width, 0); pass(blurMat, tmp);
  blurMat.uniforms.tMap.value = tmp.texture; blurMat.uniforms.uDir.value.set(0, 1 / dst.height); pass(blurMat, dst);
}
function renderFrame() {
  if (bloomOK) {
    try {
      camera.layers.set(0);
      renderer.setRenderTarget(rtScene);
      renderer.render(scene, camera);
      camera.layers.set(1);
      renderer.setRenderTarget(rtSoft);
      renderer.render(scene, camera);
      brightMat.uniforms.tMap.value = rtScene.texture;
      brightMat.uniforms.tSoft.value = rtSoft.texture;
      pass(brightMat, rtB[0]);
      blur(rtB[0], rtA[0], rtB[0]);
      for (let i = 1; i < LV; i++) blur(rtB[i - 1], rtA[i], rtB[i]);
      compMat.uniforms.tScene.value = rtScene.texture;
      compMat.uniforms.tSoft.value = rtSoft.texture;
      compMat.uniforms.tB0.value = rtB[0].texture;
      compMat.uniforms.tB1.value = rtB[1].texture;
      compMat.uniforms.tB2.value = rtB[2].texture;
      pass(compMat, null);
      return;
    } catch (e) { bloomOK = false; }
  }
  camera.layers.enableAll();
  renderer.setRenderTarget(null);
  renderer.render(scene, camera);
}

const group = new THREE.Group();
group.position.y = 0.9;
scene.add(group);

// Floor grid that glides toward the camera (sharp lines, so it stays in the MSAA layer)
const gp = [], GS = 40, STEP = 1.5;
for (let i = -GS; i <= GS; i += STEP) gp.push(i, 0, -GS, i, 0, GS, -GS, 0, i, GS, 0, i);
const floorGeo = new THREE.BufferGeometry();
floorGeo.setAttribute('position', new THREE.Float32BufferAttribute(gp, 3));
const floorU = { uColor: { value: new THREE.Color(COLOR.idle) } };
tints.push(floorU.uColor.value);
const floor = new THREE.LineSegments(floorGeo, new THREE.ShaderMaterial({
  uniforms: floorU, ...ADD,
  vertexShader: `varying vec3 vP; void main(){ vP = position; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
  fragmentShader: `uniform vec3 uColor; varying vec3 vP;
    void main(){ float d = length(vP.xz); float a = (1.0 - smoothstep(4.0, 26.0, d)) * 0.5;
      gl_FragColor = vec4(uColor * 1.4, a); }`
}));
floor.position.y = -3.8;
floor.matrixAutoUpdate = false;
scene.add(floor);

// Background glow (two layers, soft layer)
const glowMat = new THREE.SpriteMaterial({ map: gtex, color: COLOR.idle, opacity: 0.55, ...ADD });
tints.push(glowMat.color);
const glow = soft(new THREE.Sprite(glowMat));
glow.scale.setScalar(9);
group.add(glow);
const glow2Mat = new THREE.SpriteMaterial({ map: gtex, color: COLOR.idle, opacity: 0.35, ...ADD });
tints.push(glow2Mat.color);
const glow2 = soft(new THREE.Sprite(glow2Mat));
glow2.scale.setScalar(3.2);
group.add(glow2);

// Core: plasma shader with fresnel, bulges when Jarvis speaks
const coreU = { uColor: { value: new THREE.Color(COLOR.idle) }, uTime: { value: 0 }, uAmp: { value: 0 } };
tints.push(coreU.uColor.value);
const coreMat = new THREE.ShaderMaterial({
  uniforms: coreU, ...ADD,
  vertexShader: `uniform float uTime; uniform float uAmp; varying vec3 vN; varying vec3 vV; varying vec3 vP;
    float h(vec3 p){ return sin(p.x * 5.0 + uTime * 1.3) * sin(p.y * 6.0 - uTime) * sin(p.z * 5.0 + uTime * 0.7); }
    void main(){
      vP = position;
      vec3 pos = position + normal * h(position * 1.5) * (0.04 + uAmp * 0.09);
      vec4 mv = modelViewMatrix * vec4(pos, 1.0);
      vN = normalize(normalMatrix * normal); vV = normalize(-mv.xyz);
      gl_Position = projectionMatrix * mv; }`,
  fragmentShader: `uniform vec3 uColor; uniform float uTime; varying vec3 vN; varying vec3 vV; varying vec3 vP;
    float h(vec3 p){ return sin(p.x * 5.0 + uTime * 1.3) * sin(p.y * 6.0 - uTime) * sin(p.z * 5.0 + uTime * 0.7); }
    void main(){
      float f = pow(clamp(1.0 - abs(dot(normalize(vN), normalize(vV))), 0.0, 1.0), 2.2);
      float pl = clamp(0.5 + 0.5 * (h(vP) + 0.5 * h(vP * 2.1 + 3.0)), 0.0, 1.25);
      float band = 0.5 + 0.5 * sin(vN.y * 14.0 + uTime * 3.0);
      vec3 col = uColor * (0.3 + f * 1.6 + pl * 0.7 + band * 0.15);
      col += vec3(1.0) * pow(pl, 4.0) * 0.35;
      gl_FragColor = vec4(col, 0.6 + f * 0.4); }`
});
const core = new THREE.Mesh(new THREE.IcosahedronGeometry(0.6, 4), coreMat);
group.add(core);

const shell = new THREE.Mesh(new THREE.IcosahedronGeometry(0.9, 1), mk(0.45, { wireframe: true }));
group.add(shell);

const hot = new THREE.Mesh(new THREE.SphereGeometry(0.22, 32, 32), mk(0.95));
hot.material.color.setRGB(3, 3, 3); tints.pop(); // the center stays white and hot
group.add(hot);

// Gyroscope rings: the pivot tilts them in 3D, the ring rotates in its own plane
const rings = [];
[
  { r: 1.35, tube: 0.025, arc: Math.PI * 2, tx: 0.0, ty: 0.0, spd: 0.5, op: 0.95 },
  { r: 1.8, tube: 0.03, arc: Math.PI * 1.5, tx: 0.9, ty: 0.2, spd: -0.7, op: 0.85 },
  { r: 2.3, tube: 0.02, arc: Math.PI * 1.2, tx: -0.7, ty: 0.6, spd: 0.4, op: 0.8 },
  { r: 2.8, tube: 0.035, arc: Math.PI * 1.7, tx: 0.35, ty: -0.9, spd: -0.3, op: 0.7 },
  { r: 3.3, tube: 0.015, arc: Math.PI * 2, tx: 1.2, ty: 0.0, spd: 0.2, op: 0.5 }
].forEach(o => {
  const pivot = new THREE.Group();
  pivot.rotation.set(o.tx, o.ty, 0);
  const ring = new THREE.Mesh(new THREE.TorusGeometry(o.r, o.tube, 12, 220, o.arc), mk(o.op));
  ring.userData.spd = o.spd;
  pivot.add(ring); group.add(pivot); rings.push(ring);
});

// Dashed outer rings, rotating in opposite directions
const dashed = [];
[4.3, 4.65].forEach((r, i) => {
  const pts = [];
  for (let k = 0; k <= 256; k++) { const a = k / 256 * Math.PI * 2; pts.push(new THREE.Vector3(Math.cos(a) * r, Math.sin(a) * r, 0)); }
  const g = new THREE.BufferGeometry().setFromPoints(pts);
  const m = new THREE.LineDashedMaterial({ color: COLOR.idle, dashSize: 0.2 - i * 0.07, gapSize: 0.12 + i * 0.1, opacity: 0.55, ...ADD });
  tints.push(m.color);
  const l = new THREE.Line(g, m);
  l.computeLineDistances();
  l.userData.spd = i ? 0.15 : -0.1;
  group.add(l); dashed.push(l);
});

// Radar sweep in the reactor plane (soft layer)
const sweepU = { uColor: { value: new THREE.Color(COLOR.idle) }, uAng: { value: 0 } };
tints.push(sweepU.uColor.value);
const sweep = soft(new THREE.Mesh(new THREE.CircleGeometry(3.6, 96), new THREE.ShaderMaterial({
  uniforms: sweepU, ...ADD, side: THREE.DoubleSide,
  vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
  fragmentShader: `uniform vec3 uColor; uniform float uAng; varying vec2 vUv;
    void main(){
      vec2 p = vUv - 0.5; float len = length(p);
      float a = atan(p.y, p.x);
      float d = mod(uAng - a, 6.2831853);
      float al = exp(-d * 1.6) * 0.4 * smoothstep(0.12, 0.2, len) * (1.0 - smoothstep(0.42, 0.5, len));
      gl_FragColor = vec4(uColor * 1.5, al); }`
})));
sweep.position.z = -0.05;
group.add(sweep);

// Tick ring: instanced marks around the edge (static matrices, set once)
const TICKS = 120;
const tickMesh = new THREE.InstancedMesh(new THREE.BoxGeometry(0.02, 0.14, 0.02), mk(0.8), TICKS);
const dummy = new THREE.Object3D();
for (let i = 0; i < TICKS; i++) {
  const a = i / TICKS * Math.PI * 2;
  dummy.position.set(Math.cos(a) * 3.7, Math.sin(a) * 3.7, 0);
  dummy.rotation.set(0, 0, a - Math.PI / 2);
  dummy.scale.set(1, i % 10 === 0 ? 2.2 : 1, 1);
  dummy.updateMatrix();
  tickMesh.setMatrixAt(i, dummy.matrix);
}
tickMesh.instanceMatrix.needsUpdate = true;
group.add(tickMesh);

// Audio bars: height is computed on the GPU, matrices are set only once
const BARS = 120;
const barGeo = new THREE.BoxGeometry(0.03, 1, 0.03);
barGeo.translate(0, 0.5, 0);
const bi = new Float32Array(BARS);
for (let i = 0; i < BARS; i++) bi[i] = i;
barGeo.setAttribute('aI', new THREE.InstancedBufferAttribute(bi, 1));
const barU = { uColor: { value: new THREE.Color(COLOR.idle) }, uT: { value: 0 }, uLvl: { value: 0.05 }, uThink: { value: 0 }, uOp: { value: 0.9 } };
tints.push(barU.uColor.value);
const barMesh = new THREE.InstancedMesh(barGeo, new THREE.ShaderMaterial({
  uniforms: barU, ...ADD,
  vertexShader: `attribute float aI; uniform float uT; uniform float uLvl; uniform float uThink;
    void main(){
      float n = 0.5 + 0.5 * sin(aI * 0.9 + uT * 7.0) * sin(aI * 0.37 - uT * 3.1);
      float h = 0.04 + uLvl * n;
      float d = mod(aI - uT * 20.0, ${BARS}.0);
      h += uThink * 0.5 * exp(-d * 0.25);
      h = min(h, 0.6);
      vec4 p = instanceMatrix * vec4(position.x, position.y * h, position.z, 1.0);
      gl_Position = projectionMatrix * modelViewMatrix * p; }`,
  fragmentShader: `uniform vec3 uColor; uniform float uOp; void main(){ gl_FragColor = vec4(uColor, uOp); }`
}), BARS);
for (let i = 0; i < BARS; i++) {
  const a = i / BARS * Math.PI * 2;
  dummy.position.set(Math.cos(a) * 3.95, Math.sin(a) * 3.95, 0);
  dummy.rotation.set(0, 0, a - Math.PI / 2);
  dummy.scale.set(1, 1, 1);
  dummy.updateMatrix();
  barMesh.setMatrixAt(i, dummy.matrix);
}
barMesh.instanceMatrix.needsUpdate = true;
barMesh.frustumCulled = false;
group.add(barMesh);

// Radial spokes between the core and the innermost ring
const spokePos = [];
for (let i = 0; i < 24; i++) {
  const a = i / 24 * Math.PI * 2;
  spokePos.push(Math.cos(a) * 0.95, Math.sin(a) * 0.95, 0, Math.cos(a) * 1.3, Math.sin(a) * 1.3, 0);
}
const spokeGeo = new THREE.BufferGeometry();
spokeGeo.setAttribute('position', new THREE.Float32BufferAttribute(spokePos, 3));
const spokeMat = new THREE.LineBasicMaterial({ color: COLOR.idle, opacity: 0.4, ...ADD });
tints.push(spokeMat.color);
const spokes = new THREE.LineSegments(spokeGeo, spokeMat);
group.add(spokes);

// Shockwaves: flat rings that grow outward and fade
const waves = [];
for (let i = 0; i < 4; i++) {
  const w = new THREE.Mesh(new THREE.RingGeometry(0.97, 1, 160), mk(0, { side: THREE.DoubleSide }));
  w.userData.age = 1;
  group.add(w); waves.push(w);
}
function pulseWave() {
  const w = waves.find(w => w.userData.age >= 1);
  if (w) w.userData.age = 0;
}

// Lightning arcs from the core out toward the rings
const ARCS = 8, ARC_PTS = 28;
