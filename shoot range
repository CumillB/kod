    targets = [];
    particles = [];
    shells = [];
    floatingTexts = [];
    bulletHoles = [];

    spawnTimer = .3;

    menu.classList.add("hidden");

    lastFrame = performance.now();

    updateHUD();

    requestAnimationFrame(loop);
}


/* END */

function endGame() {

